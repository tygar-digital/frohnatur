---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.jsx';
import Innenraum from '../components/Innenraum.astro';
import Angebot from '../components/Angebot.jsx';
import Story from '../components/Story.jsx';
import Galerie from '../components/Galerie.jsx';
import Kontakt from '../components/Kontakt.jsx';
import Footer from '../components/Footer.astro';
---

<Layout>
<Hero client:load />
<Innenraum />
<div class="relative z-[2]" style="margin-top: -80vh;">
  <Angebot client:visible />
  <Story client:visible />
  <Galerie client:visible />
  <Kontakt client:visible />
  <Footer />
</div>
</Layout>

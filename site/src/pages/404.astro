---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Seite nicht gefunden — Frohnatur" description="Diese Seite gibt es leider nicht.">
  <section class="relative bg-cream-light texture-grain min-h-screen flex items-center justify-center py-20 md:py-28">
    <div class="relative z-10 px-6 sm:px-8 md:px-12 lg:px-16 xl:max-w-[800px] xl:mx-auto xl:px-20 text-center">

      <div class="soft-card p-8 md:p-12 lg:p-16">
        <img
          src="/assets/Charakter1.svg"
          alt="Frohnatur Charakter"
          class="w-[120px] h-auto mx-auto mb-6 md:mb-8"
        />

        <h1 class="font-display font-bold italic text-[2.5rem] md:text-[3.5rem] uppercase tracking-[-0.01em] leading-[1.05] text-brown-dark mb-3 md:mb-4">
          Verirrt?
        </h1>

        <p class="font-display italic font-medium text-[1rem] md:text-[1.15rem] leading-[1.4] text-brown-warm mb-6 md:mb-8 max-w-[360px] mx-auto">
          Diese Seite gibt's leider nicht — aber guten Kaffee schon.
        </p>

        <a
          href="/"
          class="inline-flex items-center gap-2 font-display font-bold text-[0.8rem] tracking-[0.08em] uppercase text-white bg-red px-7 py-3.5 rounded-xl no-underline soft-btn"
        >
          <span aria-hidden="true">&larr;</span> Zurück zur Startseite
        </a>
      </div>

    </div>
  </section>
</Layout>

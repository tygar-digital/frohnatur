---
/**
 * Innenraum — Full-width interior image between Hero and Angebot.
 * The image stays sticky while subsequent sections scroll over it.
 *
 * How it works:
 * - Wrapper height = 100vh (image) + 80vh (scroll distance while stuck)
 * - Sticky element stays at top:0 for 80vh of scrolling
 * - Following content div has margin-top: -80vh + z-index: 2,
 *   pulling it up so it overlaps and slides over the image
 */
---

<div class="innenraum-wrapper relative" style="height: 180vh;">
  <div class="sticky top-0 h-screen overflow-hidden z-[1]">
    <picture>
      <source
        media="(max-width: 767px)"
        srcset="/assets/innenraum-mobile.webp"
        type="image/webp"
      />
      <source
        media="(min-width: 768px)"
        srcset="/assets/innenraum-desktop.webp"
        type="image/webp"
      />
      <img
        class="w-full h-full object-cover"
        src="/assets/innenraum-desktop.webp"
        alt="Frohnatur Kaffeeshop — Speisekarte, Latte Art und hausgemachter Kuchen auf dem Tisch"
        loading="eager"
      />
    </picture>
  </div>
</div>

---
/**
 * Innenraum — Full-width interior image between Hero and Angebot.
 * The image stays sticky while the next section scrolls over it.
 */
---

<div class="innenraum-wrapper relative" style="height: 85vh;">
  <div class="sticky top-0 h-screen overflow-hidden">
    <img
      class="w-full h-full object-cover"
      src="https://images.unsplash.com/photo-1554118811-1e0d58224f24?w=1400&q=80"
      alt="Blick in das Café Frohnatur — gemütlicher Innenraum mit warmer Beleuchtung"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-cream-light via-transparent to-transparent opacity-40" style="height: 15%;"></div>
  </div>
</div>

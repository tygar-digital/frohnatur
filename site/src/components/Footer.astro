---
const year = new Date().getFullYear();
---

<footer class="footer-section relative bg-brown-dark texture-grain py-10 md:py-12 lg:py-14 overflow-hidden">
  <div class="relative z-10 px-6 sm:px-8 md:px-12 lg:px-16 xl:max-w-[1400px] xl:mx-auto xl:w-full xl:px-20">

    {/* Logo + Tagline */}
    <div class="text-center mb-8 md:mb-10">
      <img
        class="footer-logo h-5 lg:h-6 w-auto mx-auto mb-3"
        src="/assets/logo.svg"
        alt="Frohnatur"
      />
      <p class="font-display italic font-medium text-[0.85rem] md:text-[0.9rem] text-cream-warm opacity-60">
        Dein Café im Agnesviertel
      </p>
    </div>

    {/* Info Grid: Adresse, Öffnungszeiten, Social */}
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 sm:gap-8 text-center mb-8 md:mb-10">

      {/* Adresse */}
      <div>
        <h3 class="font-display font-bold text-[0.7rem] md:text-[0.75rem] uppercase tracking-[0.1em] text-cream-warm opacity-60 mb-2">
          Adresse
        </h3>
        <p class="font-body text-[0.8rem] md:text-[0.85rem] leading-[1.6] text-cream-warm opacity-50">
          Neusser Straße 34<br />
          50670 Köln · Agnesviertel
        </p>
      </div>

      {/* Öffnungszeiten */}
      <div>
        <h3 class="font-display font-bold text-[0.7rem] md:text-[0.75rem] uppercase tracking-[0.1em] text-cream-warm opacity-60 mb-2">
          Öffnungszeiten
        </h3>
        <p class="font-body text-[0.8rem] md:text-[0.85rem] leading-[1.6] text-cream-warm opacity-50">
          Mo – So: 9 – 18 Uhr
        </p>
      </div>

      {/* Social */}
      <div>
        <h3 class="font-display font-bold text-[0.7rem] md:text-[0.75rem] uppercase tracking-[0.1em] text-cream-warm opacity-60 mb-2">
          Folge uns
        </h3>
        <div class="flex flex-col items-center gap-0.5">
          <a
            href="https://instagram.com/frohnatur.coffeeshop"
            target="_blank"
            rel="noopener noreferrer"
            class="font-body text-[0.8rem] md:text-[0.85rem] text-cream-warm opacity-50 hover:opacity-80 underline underline-offset-2 transition-opacity duration-200"
          >
            @frohnatur.coffeeshop
          </a>
          <a
            href="https://instagram.com/frohnatur.bistrooo"
            target="_blank"
            rel="noopener noreferrer"
            class="font-body text-[0.75rem] text-cream-warm opacity-35 hover:opacity-60 underline underline-offset-2 transition-opacity duration-200"
          >
            @frohnatur.bistrooo
          </a>
          <a
            href="https://instagram.com/frohnatur.bar"
            target="_blank"
            rel="noopener noreferrer"
            class="font-body text-[0.75rem] text-cream-warm opacity-35 hover:opacity-60 underline underline-offset-2 transition-opacity duration-200"
          >
            @frohnatur.bar
          </a>
        </div>
      </div>
    </div>

    {/* Divider — soft gradient */}
    <div class="w-full soft-divider-dark mb-6 md:mb-8" aria-hidden="true"></div>

    {/* Bottom row */}
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 text-center sm:text-left">
      <p class="font-body text-[0.7rem] md:text-[0.75rem] text-cream-warm opacity-40">
        &copy; {year} Frohnatur
      </p>
      <div class="flex items-center justify-center sm:justify-end gap-4">
        <a
          href="/impressum"
          class="font-body text-[0.7rem] md:text-[0.75rem] text-cream-warm opacity-40 hover:opacity-70 underline underline-offset-2 transition-opacity duration-200"
        >
          Impressum
        </a>
        <span class="text-cream-warm opacity-20" aria-hidden="true">|</span>
        <a
          href="/datenschutz"
          class="font-body text-[0.7rem] md:text-[0.75rem] text-cream-warm opacity-40 hover:opacity-70 underline underline-offset-2 transition-opacity duration-200"
        >
          Datenschutz
        </a>
      </div>
    </div>

  </div>
</footer>

---
const year = new Date().getFullYear();
---

<footer class="footer-section relative bg-brown-dark texture-grain py-10 md:py-12 lg:py-14 overflow-hidden">
  <div class="relative z-10 px-6 sm:px-8 md:px-12 lg:px-16 xl:max-w-[1400px] xl:mx-auto xl:w-full xl:px-20">

    {/* Logo + Tagline */}
    <div class="text-center mb-8 md:mb-10">
      <img
        class="footer-logo h-5 lg:h-6 w-auto mx-auto mb-3"
        src="/assets/logo.svg"
        alt="Frohnatur"

      />
      <p class="font-display italic font-medium text-[0.85rem] md:text-[0.9rem] text-cream-warm opacity-75">
        Your Local Hangout
      </p>
    </div>

    {/* Decorative separator */}
    <div class="flex items-center justify-center gap-2 mb-6 md:mb-8" aria-hidden="true">
      <span class="block w-1 h-1 rounded-full bg-cream-warm opacity-25"></span>
      <span class="block w-1.5 h-1.5 rounded-full bg-cream-warm opacity-35"></span>
      <span class="block w-1 h-1 rounded-full bg-cream-warm opacity-25"></span>
    </div>

    {/* Social */}
    <div class="text-center mb-8 md:mb-10">
      <h3 class="font-display font-bold text-[0.8rem] md:text-[0.85rem] uppercase tracking-[0.1em] text-cream-warm opacity-80 mb-2">
        Folge uns
      </h3>
      <div class="flex flex-col items-center gap-1">
        <a
          href="https://instagram.com/frohnatur.coffeeshop"
          target="_blank"
          rel="noopener noreferrer"
          class="font-body text-[0.85rem] md:text-[0.9rem] text-cream-warm opacity-65 hover:opacity-85 underline underline-offset-2 transition-opacity duration-200"
        >
          @frohnatur.coffeeshop
        </a>
        <a
          href="https://instagram.com/frohnatur.bistrooo"
          target="_blank"
          rel="noopener noreferrer"
          class="font-body text-[0.8rem] text-cream-warm opacity-60 hover:opacity-85 underline underline-offset-2 transition-opacity duration-200"
        >
          @frohnatur.bistrooo
        </a>
        <a
          href="https://instagram.com/frohnatur.bar"
          target="_blank"
          rel="noopener noreferrer"
          class="font-body text-[0.8rem] text-cream-warm opacity-60 hover:opacity-85 underline underline-offset-2 transition-opacity duration-200"
        >
          @frohnatur.bar
        </a>
      </div>
    </div>

    {/* Divider — soft gradient */}
    <div class="w-full soft-divider-dark mb-6 md:mb-8" aria-hidden="true"></div>

    {/* Bottom row */}
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 text-center sm:text-left">
      <p class="font-body text-[0.8rem] md:text-[0.85rem] text-cream-warm opacity-60">
        &copy; {year} Frohnatur
      </p>
      <div class="flex items-center justify-center sm:justify-end gap-4">
        <a
          href="/impressum"
          class="font-body text-[0.8rem] md:text-[0.85rem] text-cream-warm opacity-60 hover:opacity-80 underline underline-offset-2 transition-opacity duration-200"
        >
          Impressum
        </a>
        <span class="text-cream-warm opacity-20" aria-hidden="true">|</span>
        <a
          href="/datenschutz"
          class="font-body text-[0.8rem] md:text-[0.85rem] text-cream-warm opacity-60 hover:opacity-80 underline underline-offset-2 transition-opacity duration-200"
        >
          Datenschutz
        </a>
      </div>
    </div>

  </div>
</footer>

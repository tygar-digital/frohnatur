---
import '../styles/global.css';
import '../styles/hero.css';
import '../styles/angebot.css';
import '../styles/story.css';
import '../styles/galerie.css';
import '../styles/kontakt.css';
import '../styles/footer.css';
import CoffeeBeanScatter from '../components/CoffeeBeanScatter.jsx';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Frohnatur — Dein Café im Agnesviertel, Köln',
  description = 'Specialty Coffee, Frühstück & Naturwein im Agnesviertel. Mo–Fr 9–18h, Sa–So 10–18h. Neusser Str. 34, 50670 Köln.'
} = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500;1,600;1,700;1,800&family=DM+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://frohnatur.de" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:url" content="https://frohnatur.de" />
    <meta property="og:image" content="https://frohnatur.de/assets/og-image.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Schema.org LocalBusiness -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CafeOrCoffeeShop",
      "name": "Frohnatur",
      "description": "Specialty Coffee, Frühstück & Naturwein im Agnesviertel, Köln.",
      "url": "https://frohnatur.de",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Neusser Straße 34",
        "addressLocality": "Köln",
        "postalCode": "50670",
        "addressCountry": "DE"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 50.9518,
        "longitude": 6.9565
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "09:00",
          "closes": "18:00"
        },
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Saturday", "Sunday"],
          "opens": "10:00",
          "closes": "18:00"
        }
      ],
      "servesCuisine": ["Coffee", "Breakfast", "Pastries"],
      "telephone": "+49-XXX-XXXXXXX",
      "priceRange": "€€",
      "image": "https://frohnatur.de/assets/og-image.jpg"
    })} />
  </head>
  <body class="relative">
    <a href="#main" class="skip-to-content">Zum Inhalt springen</a>
    <CoffeeBeanScatter />
    <main id="main">
      <slot />
    </main>
  </body>
</html>

---
import '../styles/global.css';
import '../styles/hero.css';
import '../styles/angebot.css';
import '../styles/story.css';
import '../styles/galerie.css';
import '../styles/kontakt.css';
import '../styles/footer.css';
import CoffeeBeanScatter from '../components/CoffeeBeanScatter.jsx';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Frohnatur — Dein Café im Agnesviertel, Köln',
  description = 'Specialty Coffee, Frühstück & Kuchen im Agnesviertel. Mo–So 9–18h. Neusser Str. 34, 50670 Köln.'
} = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://frohnatur.de" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:url" content="https://frohnatur.de" />
    <meta property="og:image" content="https://frohnatur.de/assets/og-image.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Schema.org LocalBusiness -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CafeOrCoffeeShop",
      "name": "Frohnatur",
      "description": "Specialty Coffee, Frühstück & Kuchen im Agnesviertel, Köln.",
      "url": "https://frohnatur.de",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Neusser Straße 34",
        "addressLocality": "Köln",
        "postalCode": "50670",
        "addressCountry": "DE"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 50.9518,
        "longitude": 6.9565
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
          "opens": "09:00",
          "closes": "18:00"
        }
      ],
      "servesCuisine": ["Coffee", "Breakfast", "Pastries"],
      "telephone": "+49-XXX-XXXXXXX",
      "priceRange": "€€",
      "image": "https://frohnatur.de/assets/og-image.jpg"
    })} />
  </head>
  <body class="relative">
    <div class="bg-brown-dark text-center py-1 px-4 pointer-events-none z-[100] relative">
      <span class="inline-block text-cream-warm/60 text-[0.6rem] tracking-[0.1em] uppercase font-display font-medium">Entwurf — keine offizielle Website</span>
    </div>
    <a href="#main" class="skip-to-content">Zum Inhalt springen</a>
    <CoffeeBeanScatter />
    <main id="main">
      <slot />
    </main>
  </body>
</html>
